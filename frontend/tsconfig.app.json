{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["svelte", "vite/client"],
    "allowArbitraryExtensions": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "moduleDetection": "force",
    "paths": {
      //общее
      "$shared/ui": ["./src/shared/ui"],
      "$shared/services": ["./src/shared/services"],
      "$shared/config": ["./src/shared/config"],
      //фичи
      "$features/settings": ["./src/features/settings"],
      "$features/appearance": ["./src/features/appearance"],
      "$features/note": ["./src/features/note"],
      "$features/modal": ["./src/features/modal"],
      "$features/background": ["./src/features/background"],
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
